# IoT Core configuration for KVS WebRTC streaming.
# Copy to ~/certs/iot.env to override any of the defaults below.
#
# All values are optional — the run script has sensible defaults:
#   - Endpoint & role alias are hardcoded for the actionbricks fleet
#   - Thing name is auto-derived from the Pi hostname
#   - Cert/key files are auto-discovered from ~/certs/

# IoT credential provider endpoint
# AWS_IOT_CORE_CREDENTIAL_ENDPOINT=c3h0j7jh565u8z.credentials.iot.us-west-2.amazonaws.com

# IAM role alias for IoT credential exchange
# AWS_IOT_CORE_ROLE_ALIAS=actionbricks_pi_alias

# IoT Thing name (default: derived from hostname, e.g. actionbricks-germany-01 → pi_germany_01)
# AWS_IOT_CORE_THING_NAME=pi_germany_01

# AWS region
# AWS_DEFAULT_REGION=us-west-2

# Explicit cert/key paths (default: auto-discovered from ~/certs/)
# AWS_IOT_CORE_CERT=/home/pi/certs/mydevice.cert.pem
# AWS_IOT_CORE_PRIVATE_KEY=/home/pi/certs/mydevice.private.key
